# StockSentry Production Environment Configuration

# Core Application
ENVIRONMENT=production
ENABLE_DOCS=false
SECRET_KEY=replace-with-64-char-random-secret
CORS_ORIGINS=https://inventory.tataplayfiber.com
FRONTEND_URL=https://inventory.tataplayfiber.com

# PostgreSQL 16
POSTGRES_USER=stocksentry_admin
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=stocksentry_prod
DATABASE_URL=postgresql://stocksentry_admin:replace-with-strong-postgres-password@postgres:5432/stocksentry_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (Multi-worker WebSocket Pub/Sub)
REDIS_URL=redis://redis:6379/0

# Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Production Admin Seeding (scripts/seed_prod.py)
INITIAL_ADMIN_EMAIL=admin@tataplayfiber.com
INITIAL_ADMIN_NAME=Tata Play Fiber Super Admin
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongInitialPassword123!

# SMTP Email (Password Reset & Backup Alerts)
SMTP_HOST=smtp.tataplayfiber.com
SMTP_PORT=587
SMTP_USER=noreply@tataplayfiber.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@tataplayfiber.com
ALERT_EMAIL=ops-alerts@tataplayfiber.com

# Backups & Monitoring
BACKUP_ROOT=/var/backups/stocksentry
RCLONE_REMOTE=
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

# Gunicorn Concurrency
WEB_CONCURRENCY=4
LOG_LEVEL=info
