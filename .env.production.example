# =====================================================================
# TATA PLAY FIBBER ENTERPRISE ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================
# Instructions:
# 1. Copy this file to .env.production on the production host:
#    cp .env.production.example .env.production
# 2. Fill in the sensitive credentials before deployment.
# =====================================================================

# Environment Mode
ENVIRONMENT=production

# Public Host / Domain Name for SSL & Routing (e.g. inventory.tataplayfiber.com)
DOMAIN_NAME=inventory.tataplayfiber.com

# Cryptographic Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_64_character_hex_string_from_openssl

# Enterprise Database Configuration (PostgreSQL 16 / Cloud SQL / AWS RDS)
POSTGRES_USER=stocksentry_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=stocksentry_prod
DATABASE_URL=postgresql://stocksentry_admin:replace_with_strong_database_password@postgres:5432/stocksentry_prod

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backend Concurrency & Worker Tuning (Default: 4 workers)
WEB_CONCURRENCY=4
PORT=8000
LOG_LEVEL=info

# Centralized CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://inventory.tataplayfiber.com,https://tataplayfiber.com

# AI Copilot Engine (Groq LLaMA 3.3 70B Versatile)
GROQ_API_KEY=gsk_your_groq_production_api_key

# Enterprise Email Alerts & Dispatch Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noc-alerts@tataplayfiber.com
SMTP_PASSWORD=your_enterprise_smtp_app_password
ALERT_RECIPIENT_EMAIL=central-operations@tataplayfiber.com
ALERT_RECIPIENT_PHONE=+919876543210

# SMS & WhatsApp Field Dispatch Provider (Twilio)
TWILIO_ACCOUNT_SID=AC_your_production_twilio_account_sid
TWILIO_AUTH_TOKEN=your_production_twilio_auth_token
TWILIO_FROM_PHONE=+17372508034
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Initial Enterprise Passwords for Seed Admin & Managers
INITIAL_ADMIN_PASSWORD=change_on_first_central_login
INITIAL_MANAGER_PASSWORD=change_on_first_hub_login
